#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# OpenWrt procd service for dimt-reconcile-v3 (receiver mode) -- SCAFFOLD.
# Install as /etc/init.d/dimt-reconcile-v3; configure via
# /etc/config/dimt or the DIMT_* environment in /etc/dimt/env.
# Starts after dimt-reconcile (S81) and frr (S95): the dynamic layer
# reconciles against live FRR state, so there is nothing to do earlier.

START=96
USE_PROCD=1

PROG=/usr/sbin/dimt-reconcile-v3.sh

start_service() {
	[ -x "$PROG" ] || return 1
	[ -r /etc/dimt/env ] && . /etc/dimt/env
	: "${DIMT_SELF:?/etc/dimt/env must set DIMT_SELF=<overlay-ipv4>}"

	procd_open_instance
	procd_set_param command "$PROG" --mode receiver --self "$DIMT_SELF" ${DIMT_V3_EXTRA_ARGS:-}
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
